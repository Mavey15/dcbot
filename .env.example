# Token Bot dari Discord Developer Portal (WAJIB)
DISCORD_TOKEN=masukkan_bot_token_anda_di_sini

# Application ID / Client ID dari Discord Developer Portal (WAJIB)
CLIENT_ID=masukkan_client_id_anda_di_sini

# (Opsional) ID Server Discord Anda untuk testing slash command secara instan.
# Kosongkan jika ingin mendaftarkan command secara global ke semua server.
GUILD_ID=

# (Opsional) ID Channel untuk pesan selamat datang & perpisahan.
# Jika kosong, bot akan otomatis memakai System Channel bawaan server.
WELCOME_CHANNEL_ID=

# (Opsional) API Key Gemini untuk fitur /ask (AI Chatbot).
# Dapatkan gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
